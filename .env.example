# AgentProbe environment variables. Copy to .env and fill in. Never commit .env.
# Grouped by the phase that first uses each variable. Example values are fake.

# ---------------------------------------------------------------------------
# Phase A: foundation (database, auth)
# ---------------------------------------------------------------------------
# Main Neon branch used by the API (psycopg 3). Paste Neon's postgresql:// string as-is; the app
# rewrites the scheme. Keep sslmode/channel_binding; use the direct (non -pooler) host. See README.
DATABASE_URL=postgresql+psycopg://user:password@ep-example.eu-central-1.aws.neon.tech/agentprobe?sslmode=require&channel_binding=require
# Separate Neon branch for integration tests. Must point at a different database than DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:password@ep-example-test.eu-central-1.aws.neon.tech/agentprobe?sslmode=require&channel_binding=require
# Set to 1 to allow `pnpm verify` to run tests against TEST_DATABASE_URL.
ALLOW_DB_TESTS=0
# Secret used to sign session JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Lifetime of the session JWT cookie, in minutes.
JWT_TTL_MINUTES=60
# Fernet key for the secrets table (ADR 0003). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me
# Comma-separated emails allowed to register. Empty = registration closed.
SIGNUP_ALLOWED_EMAILS=you@example.com
# Public origin of the web app (cookie and redirect checks).
WEB_ORIGIN=http://localhost:3000
# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Phase B: core engine (LLM layer, runner, adapters, demo agents)
# ---------------------------------------------------------------------------
# LLM backend: mock (default, deterministic, offline) or litellm (live).
LLM_PROVIDER=mock
# Set to 1 to allow any live LLM call. Live calls always go through the budget guard.
RUN_LIVE=0
# Gemini API key for live runs via LiteLLM.
GEMINI_API_KEY=
# Model per role (LiteLLM model string). No model name is hardcoded in code.
LLM_MODEL_JUDGE=
LLM_MODEL_DEMO_AGENT=
# Budget guard: hard caps on live LLM spend, in USD.
LLM_BUDGET_USD_PER_RUN=0.50
LLM_BUDGET_USD_PER_DAY=2.00
# Job queue: inline (local, no Redis) or arq (CI and production).
QUEUE_BACKEND=inline
# Redis for the arq queue. Unused when QUEUE_BACKEND=inline.
REDIS_URL=redis://localhost:6379/0
# Maximum concurrent case attempts per run.
RUNNER_CONCURRENCY=8
# Per-attempt timeout and retry count when calling the agent under test.
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_RETRIES=2
# SSRF guard: set to 1 only for local development against localhost agents.
ALLOW_PRIVATE_AGENT_URLS=0
# Where the bundled demo agents listen.
DEMO_AGENT_HOST=127.0.0.1
DEMO_AGENT_PORT=8100

# ---------------------------------------------------------------------------
# Phase C: security and AI features (mutator, clustering)
# ---------------------------------------------------------------------------
LLM_MODEL_MUTATOR=
LLM_MODEL_SUMMARIZER=
LLM_MODEL_EMBEDDING=
# pgvector column dimension. Changing it requires a migration.
EMBEDDING_DIM=768

# ---------------------------------------------------------------------------
# Phase D: CLI
# ---------------------------------------------------------------------------
# API base URL used by `agentprobe run --push`, `compare` and `--baseline`.
AGENTPROBE_API_URL=http://localhost:8000
# Project API key (starts with ap_). Created in the dashboard settings.
AGENTPROBE_API_KEY=
# Project the CLI pushes to.
AGENTPROBE_PROJECT=

# ---------------------------------------------------------------------------
# Phase E: dashboard
# ---------------------------------------------------------------------------
# FastAPI origin that Next.js rewrites /api/* to (keeps the browser same-origin).
API_INTERNAL_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Phase F: ship (CI gate, deploy, hardening)
# ---------------------------------------------------------------------------
# Requests per minute allowed per API key.
RATE_LIMIT_PER_MINUTE=120
# Token the GitHub Action uses to post the PR comment (provided by Actions).
GITHUB_TOKEN=
# Base URL of the deployed dashboard, used for links in PR comments.
PUBLIC_WEB_URL=https://agentprobe.example.com
