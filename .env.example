# AgentProbe environment variables. Copy to .env and fill in. Never commit .env.
# Grouped by the phase that first uses each variable. Example values are fake.

# ---------------------------------------------------------------------------
# Phase A: foundation (database, auth)
# ---------------------------------------------------------------------------
# Main Neon branch used by the API (psycopg 3). Paste Neon's postgresql:// string as-is; the app
# rewrites the scheme. Keep sslmode/channel_binding; use the direct (non -pooler) host. See README.
DATABASE_URL=postgresql+psycopg://user:password@ep-example.eu-central-1.aws.neon.tech/agentprobe?sslmode=require&channel_binding=require
# Separate Neon branch for integration tests. Must point at a different database than DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:password@ep-example-test.eu-central-1.aws.neon.tech/agentprobe?sslmode=require&channel_binding=require
# Set to 1 to allow `pnpm verify` to run tests against TEST_DATABASE_URL.
ALLOW_DB_TESTS=0
# Secret used to sign session JWTs (min 32 chars; the API refuses to start otherwise).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Access-token cookie lifetime, in minutes (ADR 0009). Keep it short; refresh extends sessions.
JWT_TTL_MINUTES=15
# Refresh-token cookie lifetime, in days. Rotated on every refresh.
REFRESH_TTL_DAYS=30
# Session cookies carry the Secure flag. Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=1
# Fernet key for the secrets table (ADR 0003). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me
# Comma-separated emails allowed to register. Empty = registration closed.
SIGNUP_ALLOWED_EMAILS=you@example.com
# Public origin of the web app. Cookie-authenticated mutations must send this exact Origin (CSRF).
WEB_ORIGIN=http://localhost:3000
# Rate limiting (token buckets): memory (per process, default) or redis (shared, uses REDIS_URL).
RATE_LIMIT_BACKEND=memory
# Requests per minute per client IP, shared by /auth/register and /auth/login.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Read by uvicorn: peers whose X-Forwarded-For is trusted for the client IP. Set to the proxy's
# address in production; unset, everyone behind the proxy shares one rate-limit bucket (ADR 0009).
# FORWARDED_ALLOW_IPS=127.0.0.1
# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Phase B: core engine (LLM layer, runner, adapters, demo agents)
# ---------------------------------------------------------------------------
# LLM backend: mock (default, deterministic, offline) or litellm (live).
LLM_PROVIDER=mock
# Set to 1 to allow any live LLM call. Live calls always go through the budget guard.
RUN_LIVE=0
# Gemini API key for live runs via LiteLLM.
GEMINI_API_KEY=
# Model per role (LiteLLM model string). Defaults live in config/llm.yaml; set one here to
# override it. Every model needs a price in config/pricing.yaml. No model name is in code.
LLM_MODEL_AGENT=
LLM_MODEL_JUDGE=
LLM_MODEL_ATTACKER=
LLM_MODEL_SUMMARIZER=
LLM_MODEL_EMBEDDING=
# Rate limits per model (Gemini's free tier is per project AND per model). Copy your real values
# from https://aistudio.google.com/rate-limit. RPD persists in .agentprobe/ across processes and
# resets at midnight Pacific; reaching it fails the call with a clear error instead of waiting.
LLM_RPM=10
LLM_RPD=250
LLM_MAX_CONCURRENCY=4
# Retries on 429/5xx (exponential backoff with jitter, honoring Retry-After), and call timeout.
LLM_MAX_RETRIES=4
LLM_TIMEOUT_SECONDS=60
# Budget guard: per-run caps (calls, tokens, estimated USD) and a per-day USD cap. Estimated USD
# uses config/pricing.yaml (paid-tier rates), even on the free tier.
LLM_BUDGET_MAX_CALLS_PER_RUN=200
LLM_BUDGET_MAX_TOKENS_PER_RUN=500000
LLM_BUDGET_USD_PER_RUN=0.50
LLM_BUDGET_USD_PER_DAY=2.00
# Development: 1 = replay identical LLM calls from a disk cache (no quota, no budget used).
LLM_CACHE=0
# Local state (LLM cache, daily quota counters) and config dir, relative to the working dir.
AGENTPROBE_STATE_DIR=.agentprobe
AGENTPROBE_CONFIG_DIR=config
# Runs (ADR 0017). inline: runs execute in the API process (local, no Redis).
# redis: Taskiq jobs on Redis, executed by `pnpm dev:worker` (CI and production).
QUEUE_BACKEND=inline
INLINE_MAX_RUNS=2          # runs executing at once in the API process (inline)
RUN_CONCURRENCY=4          # attempts in flight per run (inline)
RUN_MAX_RETRIES=2          # per attempt, only when the agent is unreachable
RUN_BACKOFF_BASE_S=1.0
RUN_STALE_AFTER_S=600      # a queued/running run this quiet is resumed at startup
# Redis for QUEUE_BACKEND=redis and RATE_LIMIT_BACKEND=redis. Unused otherwise.
REDIS_URL=redis://localhost:6379/0
# Maximum concurrent case attempts per run.
RUNNER_CONCURRENCY=8
# SSRF guard (ADR 0012). Agents on private addresses (localhost, RFC 1918, CGNAT, IPv6 ULA) are
# reachable only when the agent's config sets allow_private AND this is 1. Cloud metadata and
# link-local addresses are never reachable. Set to 1 for local development against the demo
# agents. The per-agent timeout and retry count live in the agent's config.
ALLOW_PRIVATE_TARGETS=0
# Optional, for production: comma-separated hosts that private targets are limited to. Empty =
# any private host (when both opt-ins are set). Doesn't affect public targets.
PRIVATE_TARGET_ALLOWLIST=
# Port the bundled demo agents listen on (always 127.0.0.1).
DEMO_AGENTS_PORT=9000

# ---------------------------------------------------------------------------
# Phase C: security and AI features (mutator, clustering)
# ---------------------------------------------------------------------------
# pgvector column dimension. Changing it requires a migration. Live clients verify at startup
# that the embedding model returns exactly this many dimensions.
EMBEDDING_DIM=768

# ---------------------------------------------------------------------------
# Phase D: CLI
# ---------------------------------------------------------------------------
# API base URL used by `agentprobe run --push`, `compare` and `--baseline`.
AGENTPROBE_API_URL=http://localhost:8000
# Project API key (starts with ap_). Created in the dashboard settings.
AGENTPROBE_API_KEY=
# Project the CLI pushes to.
AGENTPROBE_PROJECT=

# ---------------------------------------------------------------------------
# Phase E: dashboard
# ---------------------------------------------------------------------------
# FastAPI origin that Next.js rewrites /api/* to (keeps the browser same-origin).
API_INTERNAL_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Phase F: ship (CI gate, deploy, hardening)
# ---------------------------------------------------------------------------
# Requests per minute allowed per API key (token bucket; burst = the same number).
RATE_LIMIT_PER_MINUTE=120
# Token the GitHub Action uses to post the PR comment (provided by Actions).
GITHUB_TOKEN=
# Base URL of the deployed dashboard, used for links in PR comments.
PUBLIC_WEB_URL=https://agentprobe.example.com
